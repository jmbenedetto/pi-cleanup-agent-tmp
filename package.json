{
  "name": "pi-cleanup-agent-tmp",
  "version": "1.0.0",
  "description": "Pi package that cleans .agents/tmp on graceful exit and guards OneDrive path lengths.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-extension",
    "cleanup",
    "temporary-files",
    "onedrive",
    "path-length"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jmbenedetto/pi-cleanup-agent-tmp.git"
  },
  "homepage": "https://github.com/jmbenedetto/pi-cleanup-agent-tmp#readme",
  "bugs": {
    "url": "https://github.com/jmbenedetto/pi-cleanup-agent-tmp/issues"
  },
  "files": [
    "extensions",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions/cleanup-agent-tmp.ts",
      "./extensions/path-length-guard.ts"
    ]
  },
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.99.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=20"
  }
}
